# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_RECOVERY_KEY: A secret only you (the deployer) know. Lets you reset
# the admin password from the "forgot password" screen if you get locked
# out. Leave unset to disable password recovery entirely.
ADMIN_RECOVERY_KEY="choose-a-long-random-secret"

# DATABASE_URL: اتصال Postgres برای پل‌ها و لاگ‌ها (فاز ۱ نقشه‌راه —
# references/roadmap.md). اگر با docker-compose اجرا می‌کنید نیازی به
# تنظیم دستی این مقدار نیست (docker-compose.yml خودش می‌سازدش). برای
# اجرای محلی بدون Docker، یک Postgres محلی/ابری داشته باشید و اینجا
# بگذارید، بعد یک‌بار: npx prisma migrate deploy
DATABASE_URL="postgresql://zagros:your_password@localhost:5432/zagros_repost"

# DATA_DIR: فقط برای حساب ادمین و session (src/server/auth.ts) — پل‌ها
# و لاگ‌ها از فاز ۱ به بعد در Postgres (DATABASE_URL بالا) هستند، نه اینجا.
DATA_DIR="./data"

# LOG_LEVEL: pino log level for system/operational logs (src/server/logger.ts).
# One of: fatal, error, warn, info, debug, trace. Defaults to "info".
LOG_LEVEL="info"

# --- Optional: only needed if you run the Python userbot service ---
# (used for relaying Document files that don't have a direct download link
# via the public t.me/s/ scrape — see userbot/README context in SKILL.md)
USERBOT_SERVICE_URL="http://127.0.0.1:8081"
USERBOT_SECRET="choose-a-long-random-shared-secret"
USERBOT_RELAY_CHANNEL="your_relay_channel_username"
# TELEGRAM_API_ID / TELEGRAM_API_HASH: from https://my.telegram.org, only
# needed by the userbot service itself (userbot/userbot_service.py, userbot/login.py).
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""

# NODE_WEBHOOK_URL: [فاز ۲، فقط برای اجرای دستی بدون Docker] آدرسی که
# سرویس Python باید برای پوش کردن پیام‌های زنده صدا بزند — همان جایی
# که Node شما در حال گوش دادن است، مثلاً http://127.0.0.1:3000 (نه یک
# متغیر Node، بلکه باید موقع اجرای userbot_service.py export شود).
# اگر خالی بماند، موتور push غیرفعال می‌ماند و همه‌چیز مثل قبل از فاز
# ۲ با اسکرِیپ دوره‌ای کار می‌کند — چیزی نمی‌شکند.
NODE_WEBHOOK_URL="http://127.0.0.1:3000"
